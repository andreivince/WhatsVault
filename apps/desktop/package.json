{
  "name": "whatsvault-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "visual:check": "playwright test --config playwright.visual.config.ts",
    "demo:record": "playwright test --config playwright.demo.config.ts",
    "demo:render": "node scripts/render-readme-demo.mjs",
    "demo:screenshot": "node scripts/capture-readme-screenshot.mjs",
    "demo:video": "npm run demo:record && npm run demo:render",
    "hygiene:public": "node scripts/public-hygiene.mjs",
    "release:signing": "node scripts/signing-readiness.mjs",
    "release:signing:strict": "node scripts/signing-readiness.mjs --strict",
    "release:prepare-signing-config": "node scripts/prepare-tauri-signing-config.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "release:preflight": "node scripts/release-readiness.mjs --stable",
    "release:checksums": "node scripts/generate-release-checksums.mjs",
    "release:version": "node scripts/print-release-version.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.61.0",
    "playwright-recast": "^0.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
